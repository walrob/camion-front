<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sólo las páginas públicas. Se mantiene a mano porque son pocas y cambian poco;
  si en algún momento se agregan landings por segmento, conviene generarlo.

  Las URL deben coincidir exactamente con el `canonical` que declara cada
  página (con www, sin barra final salvo la raíz): un sitemap que apunta a una
  variante distinta de la canónica se ignora.

  `lastmod` se actualiza cuando cambia el contenido de la página, no en cada
  despliegue: una fecha que se mueve sola y sin cambios reales le enseña al
  buscador a desconfiar de ella.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.camionex.com.ar/</loc>
    <lastmod>2026-09-02</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <!--
    El manual se sirve suelto desde `docs/manual-usuario` (ver `publicAssets` en
    nuxt.config.ts). Es la página con más texto del sitio y la que puede
    responder consultas de cola larga, así que se declara para que el buscador
    la encuentre aunque sólo esté enlazada desde el pie.
  -->
  <url>
    <loc>https://www.camionex.com.ar/docs/manual/manual.html</loc>
    <lastmod>2026-09-02</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://www.camionex.com.ar/terminos-y-condiciones</loc>
    <lastmod>2026-09-02</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://www.camionex.com.ar/politica-de-privacidad</loc>
    <lastmod>2026-09-02</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
